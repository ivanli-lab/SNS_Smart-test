{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "F5: Stream Lobby Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Ready: http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s/",
        "action": "openExternally"
      },
      "env": {
        "AUTO_OPEN_BROWSER": "false"
      },
      "console": "integratedTerminal"
    }
  ]
}
